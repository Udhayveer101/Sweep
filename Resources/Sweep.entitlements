<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- YARA-X compiles rule conditions to WebAssembly and runs them through wasmtime,
         which JIT-compiles to native code at scan time. Without this, the Hardened Runtime
         kills the process with CODESIGNING / Invalid Page the first time a rule evaluates. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
